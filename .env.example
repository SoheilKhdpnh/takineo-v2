# Public application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-secure-secret-at-least-32-characters"

# Pooled PostgreSQL URL used by the running application
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require"

# Direct PostgreSQL URL used by Prisma CLI and migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Mux Video
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# Kavenegar SMS OTP
# Create a lookup/verify template in the Kavenegar panel, then set these.
# Receptor numbers are sent as 98XXXXXXXXXX without a plus sign.
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=talkinu-otp
