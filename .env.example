# Public application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-secure-secret-at-least-32-characters"

# Pooled PostgreSQL URL used by the running application
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require"

# Direct PostgreSQL URL used by Prisma CLI and migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Prisma driver adapter: "neon" (default, Neon serverless) or "pg" (local Docker Postgres)
PRISMA_DATABASE_ADAPTER=neon

# Live speaking sessions (Wave 3) — required when joining rooms
# LIVE_SESSION_PROVIDER=fake|livekit
# LIVE_SESSION_REJOIN_GRACE_MS=300000
# LIVE_SESSION_EVIDENCE_HORIZON_GRACE_MS=120000
# LIVE_SESSION_WEBHOOK_SECRET=  # required only for fake provider (32+ chars)
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_WS_URL=ws://127.0.0.1:7880
# LIVEKIT_HTTP_URL=http://127.0.0.1:7880
# Local Docker: see .env.docker.example and docs/operations/local-docker.md

# Kavenegar SMS OTP
# Create a lookup/verify template in the Kavenegar panel, then set these.
# Receptor numbers are sent as 98XXXXXXXXXX without a plus sign.
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=talkinu-otp

# Student study-assistant chat (Wave 4 self-hosted, OpenAI-compatible)
# Example: http://127.0.0.1:8080  → POST /v1/chat/completions
# Leave unset to show the “assistant not connected” state in the student UI.
STUDENT_AI_CHAT_URL=
STUDENT_AI_CHAT_MODEL=talkinu-student-assistant
STUDENT_AI_CHAT_API_KEY=
