# Copy to .env.docker for local Docker + host Next.js.
# Never commit .env.docker.

NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=local-docker-better-auth-secret-32chars

# Host-run Next.js talks to published Postgres on localhost.
PRISMA_DATABASE_ADAPTER=pg
DATABASE_URL=postgresql://takineo:takineo@127.0.0.1:5432/takineo
DIRECT_URL=postgresql://takineo:takineo@127.0.0.1:5432/takineo

LIVE_SESSION_PROVIDER=livekit
LIVE_SESSION_REJOIN_GRACE_MS=300000
LIVE_SESSION_EVIDENCE_HORIZON_GRACE_MS=120000

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_must_be_at_least_32_chars_long!!
# Browser + server on the host use the published LiveKit ports.
LIVEKIT_WS_URL=ws://127.0.0.1:7880
LIVEKIT_HTTP_URL=http://127.0.0.1:7880

# Required only when LIVE_SESSION_PROVIDER=fake
# LIVE_SESSION_WEBHOOK_SECRET=local-docker-webhook-secret-at-least-32-chars

# Optional SMS / student AI — leave blank for local infra smoke
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=talkinu-otp
STUDENT_AI_CHAT_URL=
STUDENT_AI_CHAT_MODEL=talkinu-student-assistant
STUDENT_AI_CHAT_API_KEY=
