# Copy to .env.docker for local Docker + host Next.js.
# Never commit .env.docker.

NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=local-docker-better-auth-secret-32chars

# Host-run Next.js talks to published Postgres on localhost.
PRISMA_DATABASE_ADAPTER=pg
DATABASE_URL=postgresql://takineo:takineo@127.0.0.1:5433/takineo
DIRECT_URL=postgresql://takineo:takineo@127.0.0.1:5433/takineo

# Shared secret for /api/internal/jobs/* (32+ chars). scripts/dev-local.ps1
# generates one into .env.docker when this is blank. The compose `jobs`
# service sends it to run live-session completion every minute.
INTERNAL_JOB_SECRET=

LIVE_SESSION_PROVIDER=livekit
# Rejoin is allowed until 10 minutes after the booked end, covering the
# teacher's optional 5- or 10-minute continuation. Evidence stays open 12
# minutes so completion does not run while that continuation is still going.
LIVE_SESSION_REJOIN_GRACE_MS=600000
LIVE_SESSION_EVIDENCE_HORIZON_GRACE_MS=720000

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_must_be_at_least_32_chars_long!!
# Browser + server on the host use the published LiveKit ports.
LIVEKIT_WS_URL=ws://127.0.0.1:7880
LIVEKIT_HTTP_URL=http://127.0.0.1:7880

# Wave 4 AI engines (optional on this workstation; VPS analysis host separate)
# See docs/engineering/wave4-ai-pipeline-contract.md — fail closed when unset.
# SESSION_ANALYSIS_ENABLED=0

# Required only when LIVE_SESSION_PROVIDER=fake
# LIVE_SESSION_WEBHOOK_SECRET=local-docker-webhook-secret-at-least-32-chars

# Optional SMS / student AI — leave blank for local infra smoke
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=talkinu-otp
STUDENT_AI_CHAT_URL=
STUDENT_AI_CHAT_MODEL=talkinu-student-assistant
STUDENT_AI_CHAT_API_KEY=
