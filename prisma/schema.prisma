generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  TEACHER
}

enum EnglishLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum NativeLanguage {
  fa
  en
  ar
  tr
  ku
}

enum TeacherApplicationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum TeacherIntroVideoStatus {
  UPLOAD_PENDING
  PROCESSING
  READY_FOR_REVIEW
  APPROVED
  REJECTED
  FAILED
}

enum Timezone {
  Asia_Tehran         @map("Asia/Tehran")
  Asia_Dubai          @map("Asia/Dubai")
  Europe_Berlin       @map("Europe/Berlin")
  Europe_Istanbul     @map("Europe/Istanbul")
  Europe_London       @map("Europe/London")
  America_Toronto     @map("America/Toronto")
  America_New_York    @map("America/New_York")
  America_Chicago     @map("America/Chicago")
  America_Los_Angeles @map("America/Los_Angeles")
  UTC
}

model User {
  id                    String    @id
  name                  String
  email                 String
  emailVerified         Boolean
  image                 String?
  role                  UserRole?
  onboardingCompletedAt DateTime?
  createdAt             DateTime
  updatedAt             DateTime

  sessions       Session[]
  accounts       Account[]
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model StudentProfile {
  id                 String         @id @default(cuid())
  userId             String         @unique
  englishLevel       EnglishLevel?
  learningGoal       String?
  nativeLanguage     NativeLanguage @default(fa)
  timezone           Timezone       @default(Asia_Tehran)
  profileCompletedAt DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profile")
}

model TeacherProfile {
  id                     String                   @id @default(cuid())
  userId                 String                   @unique
  headline               String?
  bio                    String?
  experienceYears        Int?
  nativeLanguage         NativeLanguage           @default(fa)
  teachingLanguage       String                   @default("en")
  timezone               Timezone                 @default(Asia_Tehran)
  profileCompletedAt     DateTime?
  applicationStatus      TeacherApplicationStatus @default(DRAFT)
  applicationSubmittedAt DateTime?
  applicationReviewedAt  DateTime?
  applicationReviewNote  String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  introVideo TeacherIntroVideo?

  @@map("teacher_profile")
}

model TeacherIntroVideo {
  id               String                  @id @default(cuid())
  teacherProfileId String                  @unique
  provider         String                  @default("mux")
  uploadId         String?                 @unique
  assetId          String?                 @unique
  playbackId       String?                 @unique
  status           TeacherIntroVideoStatus @default(UPLOAD_PENDING)
  durationSeconds  Int?
  rejectionReason  String?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@map("teacher_intro_video")
}
