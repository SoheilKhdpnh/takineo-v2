generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  TEACHER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AdminPermission {
  REVIEWER
  SUPER_ADMIN
}

enum AdminAuditAction {
  ADMIN_BOOTSTRAPPED
  ADMIN_ACCESS_GRANTED
  ADMIN_ACCESS_REVOKED
  ADMIN_PERMISSION_CHANGED
  PROFILE_APPROVED
  PROFILE_REJECTED
  VIDEO_APPROVED
  VIDEO_REJECTED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  TEACHER_SUSPENDED
  TEACHER_REINSTATED
  ACCOUNT_STATUS_CHANGED
}

enum ReviewRejectionTarget {
  PROFILE
  VIDEO
  BOTH
}

enum PlaybackDesiredState {
  ENABLED
  REVOKED
}

enum PlaybackReconciliationStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum EnglishLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum NativeLanguage {
  fa
  en
  ar
  tr
  ku
}

enum TeacherApplicationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum TeacherIntroVideoStatus {
  UPLOAD_PENDING
  PROCESSING
  READY_FOR_REVIEW
  APPROVED
  REJECTED
  FAILED
}

enum Timezone {
  Asia_Tehran         @map("Asia/Tehran")
  Asia_Dubai          @map("Asia/Dubai")
  Europe_Berlin       @map("Europe/Berlin")
  Europe_Istanbul     @map("Europe/Istanbul")
  Europe_London       @map("Europe/London")
  America_Toronto     @map("America/Toronto")
  America_New_York    @map("America/New_York")
  America_Chicago     @map("America/Chicago")
  America_Los_Angeles @map("America/Los_Angeles")
  UTC
}

model User {
  id                    String        @id
  name                  String
  email                 String
  emailVerified         Boolean
  image                 String?
  role                  UserRole?
  accountStatus         AccountStatus @default(ACTIVE)
  onboardingCompletedAt DateTime?
  createdAt             DateTime
  updatedAt             DateTime

  sessions         Session[]
  accounts         Account[]
  studentProfile   StudentProfile?
  teacherProfile   TeacherProfile?
  adminAccess      AdminAccess?
  adminAuditEvents AdminAuditEvent[] @relation("AdminAuditActor")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model StudentProfile {
  id                 String         @id @default(cuid())
  userId             String         @unique
  englishLevel       EnglishLevel?
  learningGoal       String?
  nativeLanguage     NativeLanguage @default(fa)
  timezone           Timezone       @default(Asia_Tehran)
  profileCompletedAt DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profile")
}

model TeacherProfile {
  id                          String                    @id @default(cuid())
  userId                      String                    @unique
  headline                    String?
  bio                         String?
  experienceYears             Int?
  nativeLanguage              NativeLanguage            @default(fa)
  teachingLanguage            String                    @default("en")
  timezone                    Timezone                  @default(Asia_Tehran)
  profileCompletedAt          DateTime?
  applicationStatus           TeacherApplicationStatus  @default(DRAFT)
  applicationSubmittedAt      DateTime?
  applicationReviewedAt       DateTime?
  applicationReviewNote       String?
  reviewCycle                 Int                       @default(0)
  profileRevision             Int                       @default(1)
  submittedProfileRevision    Int?
  submittedVideoId            String?
  submittedVideoRevision      Int?
  submittedVideoUploadId      String?
  submittedVideoAssetId       String?
  legacyApplicationStatus     TeacherApplicationStatus?
  legacyApplicationReviewedAt DateTime?
  legacyApplicationReviewNote String?
  legacyTrustMigrationReason  String?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  introVideo  TeacherIntroVideo?
  auditEvents AdminAuditEvent[]

  @@index([applicationStatus, applicationSubmittedAt, id])
  @@map("teacher_profile")
}

model TeacherIntroVideo {
  id                         String                   @id @default(cuid())
  teacherProfileId           String                   @unique
  provider                   String                   @default("mux")
  uploadId                   String?                  @unique
  assetId                    String?                  @unique
  reviewPlaybackId           String?                  @unique
  publicPlaybackId           String?                  @unique
  revision                   Int                      @default(1)
  legacyStatus               TeacherIntroVideoStatus?
  legacyRejectionReason      String?
  legacyTrustMigrationReason String?
  status                     TeacherIntroVideoStatus  @default(UPLOAD_PENDING)
  durationSeconds            Int?
  rejectionReason            String?
  submittedAt                DateTime?
  reviewedAt                 DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt

  teacherProfile          TeacherProfile              @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  auditEvents             AdminAuditEvent[]
  playbackReconciliations MuxPlaybackReconciliation[]

  @@map("teacher_intro_video")
}

model AdminAccess {
  id         String          @id @default(cuid())
  userId     String          @unique
  permission AdminPermission
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([permission, revokedAt])
  @@map("admin_access")
}

model AdminAuditEvent {
  id               String                 @id @default(cuid())
  actorUserId      String
  targetUserId     String?
  teacherProfileId String?
  introVideoId     String?
  action           AdminAuditAction
  rejectionTarget  ReviewRejectionTarget?
  reason           String?
  reviewCycle      Int?
  profileRevision  Int?
  videoRevision    Int?
  reviewedUploadId String?
  reviewedAssetId  String?
  metadata         Json?
  createdAt        DateTime               @default(now())

  actorUser      User               @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  teacherProfile TeacherProfile?    @relation(fields: [teacherProfileId], references: [id], onDelete: Restrict)
  introVideo     TeacherIntroVideo? @relation(fields: [introVideoId], references: [id], onDelete: Restrict)

  @@index([teacherProfileId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("admin_audit_event")
}

model MuxPlaybackReconciliation {
  id               String                       @id @default(cuid())
  introVideoId     String
  videoRevision    Int
  assetId          String
  playbackId       String?
  desiredState     PlaybackDesiredState
  intentGeneration Int                          @default(1)
  status           PlaybackReconciliationStatus @default(PENDING)
  attemptCount     Int                          @default(0)
  nextAttemptAt    DateTime                     @default(now())
  leaseToken       String?
  leaseExpiresAt   DateTime?
  lastErrorCode    String?
  lastAttemptAt    DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  introVideo TeacherIntroVideo @relation(fields: [introVideoId], references: [id], onDelete: Restrict)

  @@unique([introVideoId, videoRevision])
  @@index([status, nextAttemptAt])
  @@index([leaseExpiresAt])
  @@map("mux_playback_reconciliation")
}
